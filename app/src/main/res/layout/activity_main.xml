<!-- This root owns the window inset padding applied by MainActivity. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/root" android:layout_width="match_parent" android:layout_height="match_parent"
    tools:ignore="MergeRootFrame">
    <ScrollView android:id="@+id/configuration_screen" android:layout_width="match_parent" android:layout_height="match_parent"
        android:fillViewport="true" android:clipToPadding="false">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" android:padding="24dp" android:focusableInTouchMode="true">
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="@string/app_name" android:textSize="36sp" android:textStyle="bold"
                android:accessibilityHeading="true" tools:targetApi="28" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="4dp" android:text="@string/intro" android:textSize="16sp"
                android:textColor="@color/muted" />
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="24dp" android:padding="20dp" android:orientation="vertical"
                android:background="@drawable/panel">
                <TextView android:id="@+id/status" android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:text="@string/ready" android:textSize="16sp" android:textColor="@color/accent"
                    android:accessibilityLiveRegion="polite" />
                <TextView android:id="@+id/counter" android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:textSize="48sp" android:textStyle="bold" />
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:text="@string/completed_label" android:textSize="14sp" android:textColor="@color/muted" />
            </LinearLayout>
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="24dp" android:labelFor="@id/interval" android:text="@string/interval_label"
                android:textSize="16sp" />
            <EditText android:id="@+id/interval" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:minHeight="56dp" android:inputType="numberSigned" android:imeOptions="actionNext"
                android:selectAllOnFocus="true" android:singleLine="true" android:textSize="22sp"
                android:importantForAutofill="no" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="12dp" android:labelFor="@id/repeats" android:text="@string/repeats_label"
                android:textSize="16sp" />
            <EditText android:id="@+id/repeats" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:minHeight="56dp" android:inputType="numberSigned" android:imeOptions="actionDone"
                android:selectAllOnFocus="true" android:singleLine="true" android:textSize="22sp"
                android:importantForAutofill="no" />
            <TextView android:id="@+id/count_help" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="@string/repeat_help" android:textSize="14sp" android:textColor="@color/muted" />
            <Switch android:id="@+id/unlimited" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="12dp" android:minHeight="56dp" android:text="@string/unlimited"
                android:textSize="18sp" android:showText="false" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="@string/unlimited_help" android:textSize="14sp" android:textColor="@color/muted" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="16dp" android:labelFor="@id/sound" android:text="@string/sound_label"
                android:textSize="16sp" />
            <Spinner android:id="@+id/sound" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:minHeight="56dp" android:spinnerMode="dropdown" android:prompt="@string/sound_label" />
            <Button android:id="@+id/start_stop" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="20dp" android:minHeight="60dp" android:text="@string/start"
                android:textAllCaps="false" android:textSize="20sp" android:backgroundTint="@color/accent"
                android:textColor="@color/on_accent" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="12dp" android:text="@string/audio_help" android:textSize="14sp"
                android:textColor="@color/muted" />
            <TextView android:id="@+id/notification_hint" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="12dp" android:text="@string/notifications_off" android:textSize="14sp"
                android:textColor="@color/muted" android:visibility="gone" />
        </LinearLayout>
    </ScrollView>
    <LinearLayout android:id="@+id/playback_screen" android:layout_width="match_parent" android:layout_height="match_parent"
        android:orientation="vertical" android:padding="24dp" android:visibility="gone">
        <TextView android:id="@+id/playback_status" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:textSize="18sp" android:textColor="@color/accent" android:accessibilityLiveRegion="polite" />
        <ScrollView android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"
            android:fillViewport="true">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical" android:gravity="center" android:paddingTop="24dp" android:paddingBottom="24dp">
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:text="@string/elapsed_label" android:labelFor="@id/elapsed" android:gravity="center"
                    android:textSize="18sp" android:textColor="@color/muted" />
                <Chronometer android:id="@+id/elapsed" android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:gravity="center" android:textSize="72sp" android:textColor="@color/ink"
                    android:fontFamily="monospace" android:singleLine="true" android:autoSizeTextType="uniform"
                    android:autoSizeMinTextSize="24sp" android:autoSizeMaxTextSize="72sp" android:autoSizeStepGranularity="2sp" />
                <TextView android:id="@+id/playback_counter" android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="12dp" android:gravity="center" android:textSize="16sp" android:textColor="@color/muted" />
            </LinearLayout>
        </ScrollView>
        <TextView android:id="@+id/playback_notification_hint" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginBottom="12dp" android:text="@string/notifications_off" android:textSize="14sp"
            android:textColor="@color/muted" android:visibility="gone" />
        <Button android:id="@+id/stop" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:minHeight="60dp" android:text="@string/stop" android:textAllCaps="false" android:textSize="20sp"
            android:backgroundTint="@color/accent" android:textColor="@color/on_accent" />
    </LinearLayout>
</FrameLayout>
