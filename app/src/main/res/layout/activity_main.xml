<!-- This root owns the window inset padding applied by MainActivity. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/root" android:layout_width="match_parent" android:layout_height="match_parent"
    tools:ignore="MergeRootFrame">
    <ScrollView android:id="@+id/configuration_screen" android:layout_width="match_parent" android:layout_height="match_parent"
        android:fillViewport="true" android:clipToPadding="false">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" android:padding="@dimen/setup_padding" android:focusableInTouchMode="true">
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="@string/app_name" android:textSize="@dimen/setup_title_size" android:fontFamily="sans-serif-medium"
                android:drawableEnd="@drawable/ic_tick" android:drawablePadding="16dp" android:gravity="center_vertical"
                android:textColor="@color/ink" android:accessibilityHeading="true" tools:targetApi="28" />

            <RadioGroup android:id="@+id/limit_mode" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/setup_gap" android:orientation="horizontal">
                <RadioButton android:id="@+id/count_mode" style="@style/ModeChoice"
                    android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_weight="1"
                    android:layout_margin="2dp" android:drawableStart="@drawable/ic_count" android:text="@string/count_choice" />
                <RadioButton android:id="@+id/time_mode" style="@style/ModeChoice"
                    android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_weight="1"
                    android:layout_margin="2dp" android:drawableStart="@drawable/ic_time" android:text="@string/time_choice" />
                <RadioButton android:id="@+id/unlimited" style="@style/ModeChoice"
                    android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_weight="1"
                    android:layout_margin="2dp" android:drawableStart="@drawable/ic_unlimited" android:text="@string/unlimited" />
            </RadioGroup>

            <LinearLayout android:id="@+id/number_fields" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/setup_gap" android:orientation="horizontal" android:baselineAligned="false">
                <LinearLayout android:id="@+id/interval_fields" android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:orientation="vertical">
                    <TextView style="@style/SectionLabel" android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:labelFor="@id/interval" android:text="@string/interval_label" />
                    <EditText android:id="@+id/interval" style="@style/NumberField"
                        android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp"
                        android:imeOptions="actionNext" android:nextFocusForward="@id/repeats" android:importantForAutofill="no" />
                </LinearLayout>
                <LinearLayout android:id="@+id/limit_fields" android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:orientation="vertical" android:layout_marginStart="16dp">
                    <TextView android:id="@+id/limit_label" style="@style/SectionLabel"
                        android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:labelFor="@id/repeats" android:text="@string/repeats_label" />
                    <FrameLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp">
                        <EditText android:id="@+id/repeats" style="@style/NumberField"
                            android:layout_width="match_parent" android:layout_height="wrap_content" android:imeOptions="actionDone"
                            android:importantForAutofill="no" />
                        <LinearLayout android:id="@+id/time_limit_fields" android:layout_width="match_parent" android:layout_height="wrap_content"
                            android:orientation="horizontal" android:baselineAligned="false" android:visibility="gone">
                            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                                android:layout_marginEnd="8dp" android:orientation="vertical">
                                <EditText android:id="@+id/time_minutes" style="@style/NumberField"
                                    android:layout_width="match_parent" android:layout_height="wrap_content"
                                    android:paddingStart="12dp" android:paddingEnd="12dp"
                                    android:imeOptions="actionNext" android:nextFocusForward="@id/time_seconds" android:importantForAutofill="no" />
                                <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                                    android:layout_marginTop="6dp" android:gravity="center"
                                    android:text="@string/minutes_short" android:contentDescription="@string/minutes_label"
                                    android:textSize="12sp" android:textColor="@color/muted" android:labelFor="@id/time_minutes" />
                            </LinearLayout>
                            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                                android:orientation="vertical">
                                <EditText android:id="@+id/time_seconds" style="@style/NumberField"
                                    android:layout_width="match_parent" android:layout_height="wrap_content"
                                    android:paddingStart="12dp" android:paddingEnd="12dp" android:imeOptions="actionDone" android:importantForAutofill="no" />
                                <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                                    android:layout_marginTop="6dp" android:gravity="center"
                                    android:text="@string/seconds_short" android:contentDescription="@string/seconds_label"
                                    android:textSize="12sp" android:textColor="@color/muted" android:labelFor="@id/time_seconds" />
                            </LinearLayout>
                        </LinearLayout>
                    </FrameLayout>
                </LinearLayout>
            </LinearLayout>
            <TextView android:id="@+id/count_help" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="6dp" android:text="@string/repeat_help" android:textSize="12sp" android:textColor="@color/muted" />

            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/setup_gap" android:orientation="horizontal" android:gravity="center_vertical">
                <TextView style="@style/SectionLabel" android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:layout_marginEnd="12dp" android:labelFor="@id/sound" android:text="@string/sound_label" />
                <FrameLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                    android:background="@drawable/field_background">
                    <net.namekdev.ticker.SoundSpinner android:id="@+id/sound" android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:saveEnabled="false" android:minHeight="48dp" android:paddingStart="0dp" android:paddingEnd="40dp"
                        android:background="@android:color/transparent" android:popupBackground="@color/surface"
                        android:spinnerMode="dropdown" android:prompt="@string/sound_label" />
                    <ImageView android:layout_width="24dp" android:layout_height="24dp"
                        android:layout_gravity="end|center_vertical" android:layout_marginEnd="16dp"
                        android:src="@drawable/ic_expand" android:contentDescription="@null" android:importantForAccessibility="no" />
                </FrameLayout>
            </LinearLayout>

            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/setup_gap" android:orientation="horizontal" android:gravity="center_vertical">
                <TextView style="@style/SectionLabel" android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:layout_marginEnd="12dp" android:text="@string/session_duration" android:labelFor="@id/duration_preview" />
                <TextView android:id="@+id/duration_preview" android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:gravity="end" android:textSize="22sp"
                    android:fontFamily="sans-serif-medium" android:fontFeatureSettings="tnum"
                    android:textColor="@color/ink" tools:text="01:40" />
            </LinearLayout>
            <Button android:id="@+id/start_stop" style="@style/ActionButton"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal" android:layout_marginTop="16dp"
                android:padding="12dp" android:paddingStart="24dp" android:paddingEnd="24dp"
                android:textSize="24sp" android:text="@string/start" />
            <TextView android:id="@+id/playback_error" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="12dp" android:text="@string/playback_error" android:textSize="14sp"
                android:textColor="?android:attr/colorError" android:visibility="gone" android:accessibilityLiveRegion="polite" />
            <TextView android:id="@+id/notification_hint" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="12dp" android:text="@string/notifications_off" android:textSize="13sp"
                android:textColor="@color/muted" android:visibility="gone" />
        </LinearLayout>
    </ScrollView>

    <LinearLayout android:id="@+id/playback_screen" android:layout_width="match_parent" android:layout_height="match_parent"
        android:orientation="vertical" android:padding="24dp" android:visibility="gone">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:gravity="center_vertical">
            <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                android:text="@string/app_name" android:textSize="20sp" android:fontFamily="sans-serif-medium"
                android:textColor="@android:color/white" />
            <TextView android:id="@+id/playback_status" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_marginStart="16dp" android:textSize="14sp" android:textColor="@color/playback_accent"
                android:accessibilityLiveRegion="polite" />
        </LinearLayout>
        <ScrollView android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"
            android:fillViewport="true">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical" android:gravity="center"
                android:paddingTop="@dimen/timer_vertical_padding" android:paddingBottom="@dimen/timer_vertical_padding">
                <TextView android:id="@+id/interval_remaining" android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginBottom="@dimen/interval_spacing" android:gravity="center" android:textSize="18sp"
                    android:textColor="@color/playback_muted" android:maxLines="1" android:autoSizeTextType="uniform"
                    android:autoSizeMinTextSize="8sp" android:autoSizeMaxTextSize="18sp" android:autoSizeStepGranularity="1sp" />
                <TextView android:id="@+id/timer_label" android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:text="@string/elapsed_label" android:labelFor="@id/elapsed" android:gravity="center"
                    android:textSize="14sp" android:textColor="@color/playback_muted" />
                <TextView android:id="@+id/elapsed" android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:gravity="center" android:textSize="@dimen/timer_size" android:textColor="@android:color/white"
                    android:fontFamily="sans-serif-light" android:fontFeatureSettings="tnum" android:maxLines="1"
                    android:autoSizeTextType="uniform" android:autoSizeMinTextSize="8sp"
                    android:autoSizeMaxTextSize="@dimen/timer_size" android:autoSizeStepGranularity="2sp" />
                <TextView android:id="@+id/playback_counter" android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="8dp" android:gravity="center" android:textSize="14sp" android:textColor="@color/playback_muted" />
            </LinearLayout>
        </ScrollView>
        <TextView android:id="@+id/playback_notification_hint" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginBottom="16dp" android:text="@string/notifications_off" android:textSize="14sp"
            android:textColor="@color/playback_muted" android:visibility="gone" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:baselineAligned="false" tools:ignore="ButtonStyle">
            <Button android:id="@+id/pause_resume" style="@style/ActionButton"
                android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                android:layout_marginEnd="12dp" android:minHeight="60dp" android:text="@string/pause"
                android:backgroundTint="@color/playback_action_tint" android:textColor="@android:color/black" />
            <Button android:id="@+id/stop" style="@style/ActionButton"
                android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                android:minHeight="60dp" android:text="@string/stop"
                android:backgroundTint="@color/playback_panel" android:textColor="@android:color/white" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
