<ripple xmlns:android="http://schemas.android.com/apk/res/android" android:color="?android:attr/colorControlHighlight">
    <item>
        <selector>
            <item android:state_checked="true">
                <layer-list><item android:gravity="bottom" android:height="2dp">
                    <shape><solid android:color="@color/accent" /></shape>
                </item></layer-list>
            </item>
            <item android:drawable="@android:color/transparent" />
        </selector>
    </item>
</ripple>
